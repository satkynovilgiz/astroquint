# Public site URL used for metadata / Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required from Milestone 3 onward — leave empty for now)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
